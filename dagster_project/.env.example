# Copy to .env and fill in your own values. Never commit .env.
# Auth uses your gcloud login (no key files): run
#   gcloud auth application-default login

# Service account the pipeline impersonates locally (leave empty in production)
DAGSTER_IMPERSONATE_SA=your-dagster-sa@your-gcp-project.iam.gserviceaccount.com

# GCP project and landing bucket
GCP_PROJECT=your-gcp-project-id
GCS_LANDING_BUCKET=your-landing-bucket